  },
  "rules": [
    {
      "rule_id": "R_IP_HOST",
      "category": "URL_STRUCTURE",
      "weight": 20.0,
      "description": "IP address used as hostname instead of a domain name."
    },
    {
      "rule_id": "R_AT_SYMBOL",
      "category": "URL_STRUCTURE",
      "weight": 20.0,
      "description": "URL contains an '@' symbol, which can hide the actual destination."
    },
    {
      "rule_id": "R_BRAND_TOKEN",
      "category": "URL_STRUCTURE",
      "weight": 3.0,
      "description": "URL contains suspicious tokens often used in phishing (e.g., login, secure)."
    },
    {
      "rule_id": "R_LONG_URL",
      "category": "URL_STRUCTURE",
      "weight": 3.0,
      "description": "URL is unusually long (over 100 characters)."
    },
    {
      "rule_id": "R_DEEP_SUBDOMAINS",
      "category": "URL_STRUCTURE",
      "weight": 7.0,
      "description": "URL has an excessive number of subdomains (> 3)."
    },
    {
      "rule_id": "R_SUSPICIOUS_TLD",
      "category": "DOMAIN",
      "weight": 7.0,
      "description": "Domain uses a high-risk Top-Level Domain (e.g., .tk, .ml)."
    },
    {
      "rule_id": "R_PUNYCODE",
      "category": "DOMAIN",
      "weight": 15.0,
      "description": "URL hostname contains Punycode/IDN, often used for homoglyph attacks."
    },
    {
      "rule_id": "R_NO_HTTPS",
      "category": "SECURITY",
      "weight": 5.0,
      "description": "URL uses HTTP instead of secure HTTPS."
    },
    {
      "rule_id": "R_DOMAIN_AGE",
      "category": "REPUTATION",
      "weight": 20.0,
      "description": "Domain is very new (less than 30 days old)."
    },
    {
      "rule_id": "R_WHOIS_PRIVACY",
      "category": "REPUTATION",
      "weight": 10.0,
      "description": "WHOIS privacy protection is enabled."
    },
    {
      "rule_id": "R_CERT_INVALID",
      "category": "SECURITY",
      "weight": 20.0,
      "description": "TLS certificate is invalid or expired."
    },
    {
      "rule_id": "R_CERT_MISMATCH",
      "category": "SECURITY",
      "weight": 20.0,
      "description": "TLS certificate hostname does not match the URL."
    },
    {
      "rule_id": "R_PASSWORD_INPUT",
      "category": "BEHAVIOR",
      "weight": 15.0,
      "description": "Page contains a password input field."
    },
    {
      "rule_id": "R_EXTERNAL_LINKS",
      "category": "BEHAVIOR",
      "weight": 15.0,
      "description": "High ratio of external links (> 80%)."
    },
    {
      "rule_id": "R_META_REDIRECT",
      "category": "BEHAVIOR",
      "weight": 15.0,
      "description": "Page contains a meta refresh redirect."
    },
    {
      "rule_id": "R_SUSPICIOUS_CONTENT",
      "category": "CONTENT",
      "weight": 15.0,
      "description": "Page contains multiple suspicious keywords (e.g., login, verify, account)."
    }
